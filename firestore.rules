rules_version = '2';

// ===== SysPulse: cấu trúc dữ liệu =====
//  users/{uid}         hồ sơ do chính người dùng ghi (email, displayName, createdAt, lastLoginAt)
//  entitlements/{uid}  quyền Free / Premium. CHỈ máy chủ (Admin SDK / Cloud Functions) được ghi.
//        plan:      "free" | "premium_monthly" | "premium_lifetime"
//        status:    "active" | "expired" | "canceled" | "grace"
//        expiresAt: Timestamp (null với free và premium_lifetime)
//        source:    "google_play" | "admin"
//        updatedAt: Timestamp
//  purchases/{id}      dữ liệu giao dịch, chỉ máy chủ truy cập
//  Không có tài liệu entitlements/{uid} = gói Free.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'createdAt', 'lastLoginAt'])
        && request.resource.data.keys().hasAll(['email', 'createdAt', 'lastLoginAt'])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'lastLoginAt'])
        && (!('displayName' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
        && (!('lastLoginAt' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.lastLoginAt == request.time);

      allow delete: if false;
    }

    // Người dùng chỉ đọc quyền của chính mình, tuyệt đối không được ghi.
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /purchases/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
