    <string name="adb_card_wifi_title">Start via Wireless debugging</string>
    <string name="adb_card_wifi_desc">On Android 11 or above, you can enable Wireless debugging and connect directly from your device, without a computer.\n\nPlease view the step-by-step guide first.</string>
    <string name="adb_btn_guide">Step-by-step guide</string>
    <string name="adb_btn_pairing">Pairing</string>
    <string name="adb_btn_start">Start</string>
    <string name="adb_card_pc_title">Start by connecting to a computer</string>
    <string name="adb_card_pc_desc">Plug the phone into a computer and run one adb command. This needs to be repeated every time the device restarts.</string>
    <string name="adb_btn_cmd">View command</string>
    <string name="adb_cmd_body">On the computer (USB debugging on), run:\n\n%1$s\n\nThen come back and tap Start. Choose \"Always allow\" on the phone.</string>
    <string name="adb_copy">Copy</string>
    <string name="adb_copied">Copied</string>
    <string name="adb_guide_body">1. Connect to Wi-Fi.\n2. Turn on Developer options (tap Build number 7 times in About phone).\n3. Tap Pairing here. Allow notifications if asked.\n4. In Wireless debugging, turn it on, then tap \"Pair device with pairing code\" and keep the dialog open.\n5. Pull down the notification shade, tap \"Enter pairing code\" and type the 6 digits.\n6. When it says connected, you are done. Tap Start if it does not connect by itself.</string>
    <string name="pairing_title">Pairing</string>
    <string name="pairing_need_notif">The pairing process needs you to interact with a notification from SysPulse. Please allow SysPulse to post notifications.</string>
    <string name="pairing_notif_options">Notification options</string>
    <string name="pairing_help">Wireless debugging is opening. Turn it on, tap \"Pair device with pairing code\" and keep that dialog open. Then pull down the notification shade and tap \"Enter pairing code\".</string>
