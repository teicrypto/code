    <string name="setup_title">Set up per-app usage</string>
    <string name="setup_intro">Follow these 4 steps once (about 1 minute). Steps get a check mark automatically.</string>
    <string name="step1_title">1. Turn on Developer options</string>
    <string name="step1_desc">Open About phone and tap \"Build number\" 7 times. Skip if already on.</string>
    <string name="step1_btn">Open About phone</string>
    <string name="step2_title">2. Turn on Wireless debugging</string>
    <string name="step2_desc">Connect to Wi-Fi first. In Developer options, turn on Wireless debugging and tap Allow if asked.</string>
    <string name="step2_btn">Open Developer options</string>
    <string name="step3_title">3. Pair this phone</string>
    <string name="step3_desc">Tap the button below. Then open Wireless debugging and tap \"Pair device with pairing code\". Keep that dialog open, pull down the notification shade, tap \"Enter code\" and type the 6 digits.</string>
    <string name="step3_btn">Start pairing</string>
    <string name="step3_need_notif">Allow notifications, then tap Start pairing again</string>
    <string name="step4_title">4. Connect</string>
    <string name="step4_desc">Connects by itself after pairing. Tap if it does not.</string>
    <string name="setup_done">All set! Go back to see per-app CPU and RAM.</string>
    <string name="btn_setup">Step-by-step setup</string>




